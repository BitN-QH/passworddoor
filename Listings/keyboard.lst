  55          /*
  56          功能：显示按键的值
  57          形参：按键的值n
  58          返回值：无
  59          */
  60          void Judge_Value(uchar n)        //段选显示函数
  61          {
  62            uchar a=0,i=0;;
  63            while((a<50) && (Key!=0x0F)) //检测按键松手检测
  64            {
  65              Delayms(100);
  66              a++;
  67            }
  68            //以下代码产生1s按键提示音
  69            BuzzerOpenOrClose(buzzer_on);
  70            while(i<5)
  71            {
  72              i++;
  73                Delayms(200);
  74            }
  75            BuzzerOpenOrClose(buzzer_off);
  76          
  77            switch (ConvertToCode(n))
  78            {
  79              case 0:if(number==0)      //用户在还没有输入密码就按消除键
  80                   {
  81                      Display(CDIS16,CDIS17);
  82                    i=0;
  83                    while(i<250)
  84                    {
  85                      i++;
  86                        Delayms(250);
  87                    }
  88                    Display(CDIS1,CDIS2);   //提醒用户输入密码
  89                   }
  90                   else                   //用户在已经有密码输入的情况下按下了消除键
  91                   {  
  92                      number--;         //为了消除之前的“*”键,并在之前的“*”号处显示“-”号
  93                    lcdwritecom(0xc0+0x07+number);
  94                    lcdwritedate('-');  
  95                   }
  96                   break;
  97              case 2:if(number<=7)       //用户在还没有输入够8位密码就按下确认键
  98                  {
  99                    Display(CDIS14,CDIS15);
 100                    i=0;
 101                    while(i<250)
 102                    {
 103                      i++;
 104                        Delayms(250);
 105                    }
 106                      Display(CDIS1,CDIS2);  //提醒用户输入密码
 107                    for(i=0;i<number;i++)
 108                    {
 109                      lcdwritecom(0xc0+0x07+i); //并且保留住之前输入的密码，让用户接着输入
 110                      lcdwritedate('*');
 111                    }
