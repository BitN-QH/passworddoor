 130          /*
 131          功能描述：处理门外的用户输入的信息，并返回结果
 132          返回值：转换之后的红外值或确认的信息，以及消除已经输出的按键值
 133          参数：  现在门外用户输入的密码（例如1 2 3 4）
 134          */
 135          uchar ConvertToCode(uchar n)
 136          {
 137            switch (n)
 138            {
 139              case 0: Value2[number]=0x16;return 1;break;
 140              case 1: Value2[number]=0x0c;return 1;break;
 141              case 2: Value2[number]=0x18;return 1;break;
 142              case 3: Value2[number]=0x5e;return 1;break;
 143              case 4: Value2[number]=0x08;return 1;break;
 144              case 5: Value2[number]=0x1c;return 1;break;
 145              case 6: Value2[number]=0x5a;return 1;break;
 146              case 7: Value2[number]=0x42;return 1;break;
 147              case 8: Value2[number]=0x52;return 1;break;
 148              case 9: Value2[number]=0x4a;return 1;break;
 149              case 10: return 0;break;    //表示用户输入的是按键要求清除一个已经输入的密码
 150              case 11: return 2;break;  //表示用户按下了确认键
 151            }
 152          }
