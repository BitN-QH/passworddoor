 116                    number=0;
 117                  }
 118                  break;
 119              default :         //用户输入的是正常的0到9之间的数字
 120                  if(number<8)        //防止用户在输入够8位密码之后还继续输入数字，此时number不加，直到用户输入确认键
 121                  {
 122                    lcdwritecom(0xc0+0x07+number);
 123                    lcdwritedate(number);
 124                    number++;
 125                  }
 126                  break;
 127            }
