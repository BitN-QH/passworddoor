  25          形参：无
  26          返回值：无
  27          */
  28          void IdentifiCol()
  29          {
  30            switch(Key)
  31            {
  32              case 0xE0:IdentifiRow(0);break;  //第一列   
  33              case 0xD0:IdentifiRow(1);break;  //第二列
  34              case 0xB0:IdentifiRow(2);break;  //第三列
  35              case 0x70:IdentifiRow(3);break;  //第四列
  36            }
  37          }
